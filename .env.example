# ============================================================
#  HireSense — environment variables (ALL FREE / FREE-TIER)
# ============================================================

# --- LLM + STT providers (free) ---
GROQ_API_KEY=         # https://console.groq.com/keys (LLM + Whisper STT)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxx       # https://aistudio.google.com/app/apikey (fallback LLM)
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxx       # LiteLLM reads Gemini via this name too

# --- Model routing: 3-model chain (each has an independent rate-limit quota) ---
PRIMARY_MODEL=groq/openai/gpt-oss-120b        # Groq: ~30 RPM / 1K RPD
FALLBACK_MODEL=gemini/gemini-3.5-flash         # Gemini Flash (separate quota)
FALLBACK_MODEL_2=gemini/gemini-3.1-flash-lite  # Flash Lite (separate quota)

# --- Speech-to-text (Groq free tier: ~2,000 transcriptions/day) ---
STT_MODEL=whisper-large-v3-turbo

# --- Text-to-speech (Kokoro-82M, local CPU, zero cost) ---
# Model files (~350MB) are downloaded once: python backend/scripts/download_models.py
KOKORO_VOICE=af_heart             
KOKORO_SPEED=1.0

# --- Observability: Langfuse (optional; blank = disabled) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Session behavior ---
DEFAULT_QUESTION_COUNT=4           # main questions per mock interview (3-6)
SILENCE_TIMEOUT_SECONDS=30         # open-mic: gentle re-prompt after this long listening
MAX_UTTERANCE_SECONDS=90

# --- API ---
HIRESENSE_API_PORT=8002
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Persistence (sessions + per-turn rubric scores + latency samples) ---
HIRESENSE_DB=hiresense.db        # SQLite file (relative to backend/)


