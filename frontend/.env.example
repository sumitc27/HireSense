# Frontend env. In dev, leave VITE_API_BASE unset to use the Vite proxy (/api + /ws).
# In production, point both at your deployed FastAPI backend:
# VITE_API_BASE=https://hiresense-api.example.com
# VITE_WS_BASE=wss://hiresense-api.example.com/ws
VITE_API_BASE=/api
VITE_WS_BASE=/ws

# Clerk Auth Publishable Key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
